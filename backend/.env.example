# ─── Required ─────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=

# ─── Environment ──────────────────────────────────────────────────────────────
# development | production | testing
# Defaults to production when unset; local runs use development (HTTP cookies,
# API docs, background-thread fallback without Redis).
ENVIRONMENT=development

# ─── Database ─────────────────────────────────────────────────────────────────
# SQLite (local development)
DATABASE_URL=sqlite:///./vulnscanner.db
# PostgreSQL (staging / production)
# DATABASE_URL=postgresql+psycopg2://vulnscanner:password@localhost:5432/vulnscanner
# Log every SQL statement, including parameters such as password hashes. Debugging only.
SQL_ECHO=false
# Connection pool per process (PostgreSQL only)
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=20
# DB_POOL_TIMEOUT=30

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── LLM Provider ─────────────────────────────────────────────────────────────
# Options: anthropic | openai | ollama
LLM_PROVIDER=anthropic
# Model name — never hard-coded; always read from this variable
LLM_MODEL=claude-opus-4-5
# API key for the chosen provider (not needed for ollama)
LLM_API_KEY=
# Only used when LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
# Per provider call; hosted SDKs retry once, so one request can take about twice this.
# Keep it at or below 70 so guidance arrives before the console gives up (150 s).
# LLM_TIMEOUT_SECONDS=60

# ─── Token expiry ─────────────────────────────────────────────────────────────
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── Scan limits ──────────────────────────────────────────────────────────────
SCAN_TIMEOUT=3600
MAX_TARGETS_PER_SCAN=50
# Seconds past SCAN_TIMEOUT before an active scan whose worker died is marked failed
# SCAN_STALE_GRACE_SECONDS=900
# REPORT_JOB_TIMEOUT=900
# OS detection (-O) needs raw sockets. A root worker always gets it; set true for a
# non-root worker that has CAP_NET_RAW. Otherwise OS detection is skipped with a warning.
# NMAP_PRIVILEGED=false
# Networks never scanned, even when authorized (whitespace- or comma-separated).
# Add internal ranges such as your Docker network.
# SCAN_BLOCKED_NETWORKS=127.0.0.0/8 ::1/128 0.0.0.0/8 ::/128
# Time allowed to resolve target host names at scan start; a scan whose names
# cannot be resolved in time fails rather than skipping the blocked-network check.
# SCAN_DNS_TIMEOUT_SECONDS=5

# ─── File uploads ─────────────────────────────────────────────────────────────
UPLOAD_DIR=./uploads

# ─── Bootstrap superuser (created on startup if this email does not exist) ─────
# Set both or neither. The password must be 12+ characters, not a common password,
# and must not contain the part of the email before the @.
FIRST_SUPERUSER_EMAIL=
FIRST_SUPERUSER_PASSWORD=

# ─── Accounts ─────────────────────────────────────────────────────────────────
# ALLOW_SELF_REGISTRATION=true
# any_user | superuser
# ORG_CREATION=any_user
# Concurrent Argon2 hashes per API process (64 MiB each). A request that waits more
# than 5 s for a slot gets HTTP 429 instead of tying up the server's thread pool.
# PASSWORD_HASH_CONCURRENCY=4

# ─── CORS (space-separated allowed origins; '*' is rejected) ──────────────────
# The console served by FastAPI at :8000 is same-origin; list other dev servers here.
CORS_ORIGINS=http://localhost:8000 http://127.0.0.1:8000

# ─── Proxies, logging and API docs ────────────────────────────────────────────
# Reverse proxies whose X-Forwarded-For entries are trusted (0 = connect directly)
# TRUSTED_PROXY_HOPS=0
# DEBUG | INFO | WARNING | ERROR | CRITICAL
# LOG_LEVEL=INFO
# console | json
# LOG_FORMAT=console
# Empty: docs follow ENVIRONMENT (on in development, off in production)
# ENABLE_API_DOCS=

# ─── Rate limiting ('<count>/<second|minute|hour|day>') ────────────────────────
# Shared through Redis; per API process when Redis is unavailable.
# RATE_LIMIT_ENABLED=true
# LOGIN_RATE_LIMIT=10/minute
# REGISTER_RATE_LIMIT=10/hour
# REFRESH_RATE_LIMIT=30/minute
# PASSWORD_CHANGE_RATE_LIMIT=5/minute
# LLM_RATE_LIMIT=30/hour
# REPORT_DOWNLOAD_RATE_LIMIT=60/minute
