# Docker Compose settings: copy this file to .env in the project root.
# Generate TWO independent random hexadecimal values (64 characters each):
# python -c "import secrets; print(secrets.token_hex(32)); print(secrets.token_hex(32))"
# Hexadecimal avoids special-character escaping in the PostgreSQL connection URL.
SESSION_SECRET=
POSTGRES_PASSWORD=

POSTGRES_USER=vulnscanner
POSTGRES_DB=vulnscanner
WEB_PORT=8080

# The default stack is reachable only on this machine using HTTP.
# Remote use requires ENVIRONMENT=production and an HTTPS reverse proxy.
# (The application defaults to production when ENVIRONMENT is unset.)
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:8080 http://127.0.0.1:8080

# Optional administrator bootstrap. Leave both blank to register a normal account.
# If needed, fill BOTH values with your own email and a unique strong password.
# The password must be at least 12 characters, not a common password, and must not
# contain the part of the email before the @; otherwise the account is not created
# (see the API log).
FIRST_SUPERUSER_EMAIL=
FIRST_SUPERUSER_PASSWORD=

# Optional AI remediation provider. Without a key the app labels generic advice.
LLM_PROVIDER=anthropic
LLM_MODEL=claude-opus-4-5
LLM_API_KEY=
# For Ollama running on the Docker Desktop host:
OLLAMA_BASE_URL=http://host.docker.internal:11434

# ─── Optional (defaults shown) ────────────────────────────────────────────────
# Scan worker containers; each runs one scan at a time.
# SCAN_WORKERS=2
# Reverse proxies in front of the API whose X-Forwarded-For entries are trusted:
# 1 for the bundled nginx, 2 behind an external HTTPS proxy.
# TRUSTED_PROXY_HOPS=1
# console (readable) or json (one object per line, for log collectors)
# LOG_FORMAT=console
# Who may create accounts and organizations. For remote access consider
# ALLOW_SELF_REGISTRATION=false (the bootstrap superuser adds members) or ORG_CREATION=superuser.
# ALLOW_SELF_REGISTRATION=true
# ORG_CREATION=any_user
# API docs (/docs) follow ENVIRONMENT when empty: on in development, off in production.
# ENABLE_API_DOCS=
# Networks never scanned, even when authorized. Add this stack's Docker network
# (docker network inspect vulnscanner_default) and other internal ranges.
# SCAN_BLOCKED_NETWORKS=127.0.0.0/8 ::1/128 0.0.0.0/8 ::/128
# Rate limits ('<count>/<second|minute|hour|day>'), RATE_LIMIT_ENABLED and other
# tuning settings are passed through as well; see backend/.env.example for each.
# LOGIN_RATE_LIMIT=10/minute
# LLM_RATE_LIMIT=30/hour
# LLM_TIMEOUT_SECONDS=60
